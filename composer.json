{
    "name": "statikbe/laravel-google-authenticate",
    "description": "Google Authentication in Laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Kristof Serré",
            "email": "kristof@statik.be",
            "homepage": "https://www.statik.be"
        }, {
            "name": "Kobe Christiaensen",
            "email": "support@statik.be",
            "homepage": "https://www.statik.be"
        }
    ],
    "homepage": "https://github.com/statikbe/laravel-google-authenticate",
    "keywords": ["Laravel", "google", "authenticate", "socialite"],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "laravel/socialite": "^5.18"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.34|^3.0|^4.0",
        "laravel/pint": "^1.32",
        "spatie/laravel-permission": "^6.0|^7.0",
        "larastan/larastan": "^3.0"
    },
    "suggest": {
        "spatie/laravel-permission": "Needed by the default GrantSuperAdminRole listener and the super admin gate (^6.0|^7.0)"
    },
    "autoload": {
        "psr-4": {
            "Statikbe\\GoogleAuthenticate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Statikbe\\GoogleAuthenticate\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --no-progress --memory-limit=1G"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Statikbe\\GoogleAuthenticate\\GoogleAuthenticateServiceProvider"
            ],
            "aliases": {
                "GoogleAuthenticate": "Statikbe\\GoogleAuthenticate\\Facades\\GoogleAuthenticate"
            }
        }
    }
}
